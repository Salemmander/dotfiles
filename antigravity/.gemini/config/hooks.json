{
  "auto-format": {
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "~/.gemini/config/format-hook.sh",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "lint-on-stop": {
    "Stop": [
      {
        "type": "command",
        "command": "~/.gemini/config/lint-on-stop.sh",
        "timeout": 15
      }
    ]
  }
}
