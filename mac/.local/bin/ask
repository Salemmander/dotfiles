#!/bin/zsh

MODEL="gemma4:26b"

while [[ $# -gt 0 ]]; do
  case "$1" in
    -m)
      MODEL="$2"
      shift 2
      ;;
    *)
      break
      ;;
  esac
done

PROMPT="$*"

if [[ -z "$PROMPT" ]]; then
  echo "Usage: ask [-m model] \"your question\""
  echo "Default model: gemma4:26b"
  echo ""
  echo "Available models:"
  ollama list 2>/dev/null | tail -n +2 | awk '{print "  " $1}'
  exit 1
fi

spin=('|' '/' '-' '\\')
i=0
while true; do
  printf "\r\033[90m%-1s thinking...\033[0m" "${spin[$((i++ % 4))]}"
  sleep 0.1
done &
SPIN_PID=$!
trap 'kill $SPIN_PID 2>/dev/null; echo ""; exit' INT TERM

RESPONSE=$(curl -s --no-buffer http://localhost:11434/api/generate \
  -d "$(printf '{"model":"%s","system":"Be concise. Use markdown for formatting. Never use LaTeX-style markup like backslash-wrapped text.","prompt":"%s"}' "$MODEL" "$(echo "$PROMPT" | sed 's/"/\\"/g')")" \
  | while IFS= read -r line; do
      printf '%s' "$(echo "$line" | sed -n 's/.*"response":"\([^"]*\)".*/\1/p')" | sed 's/\\n/\
/g; s/\\t/\t/g; s/\\"/"/g'
    done)

kill $SPIN_PID 2>/dev/null
printf "\r\033[K" >&2
echo "$RESPONSE" | glow -
