prefix_rule(
    pattern = ["git"],
    decision = "allow",
    justification = "Allow routine Git inspection and local repository operations.",
)

prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "Publishing commits to a remote should be reviewed first.",
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "prompt",
    justification = "Hard resets can discard local work.",
)

prefix_rule(
    pattern = ["git", "clean", "-f"],
    decision = "prompt",
    justification = "Forced clean can delete untracked files.",
)

prefix_rule(
    pattern = ["date"],
    decision = "allow",
    justification = "Reading the current date and time is safe.",
)

prefix_rule(
    pattern = ["ls"],
    decision = "allow",
    justification = "Listing directory contents is read-only.",
)

prefix_rule(
    pattern = ["cat"],
    decision = "allow",
    justification = "Printing file contents is read-only.",
)

prefix_rule(
    pattern = ["which"],
    decision = "allow",
    justification = "Locating executables is read-only.",
)

prefix_rule(
    pattern = ["echo"],
    decision = "allow",
    justification = "Plain echo commands are safe for simple output.",
)

prefix_rule(
    pattern = ["task"],
    decision = "allow",
    justification = "Allow routine Taskwarrior reads and updates.",
)

prefix_rule(
    pattern = ["task", "done"],
    decision = "prompt",
    justification = "Completing tasks changes task state and should be confirmed.",
)

prefix_rule(
    pattern = ["task", "delete"],
    decision = "prompt",
    justification = "Deleting tasks is destructive and should be confirmed.",
)
prefix_rule(pattern=["gh", "issue", "create"], decision="allow")
