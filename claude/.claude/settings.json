{
  "permissions": {
    "allow": [
      "Bash(git log:*)",
      "Bash(git -C * log:*)",
      "Bash(git -C * branch:*)",
      "Bash(git -C * stash list:*)",
      "Bash(git branch:*)",
      "Bash(git stash list:*)",
      "Bash(fd:*)",
      "Bash(find:*)",
      "Bash(date:*)"
    ],
    "defaultMode": "default"
  },
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true
  }
}
